# Copy this file to .env and fill in your Congress API key.
# Get a free key at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# MotherDuck: set the token to write to the cloud database. Without it, get_db_connection raises
# unless ALLOW_LOCAL_DB_FALLBACK=true, which uses the local dev.duckdb.
MOTHERDUCK_DB_NAME=pulse_prod
MOTHERDUCK_TOKEN=
ALLOW_LOCAL_DB_FALLBACK=false
